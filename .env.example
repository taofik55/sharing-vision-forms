# Supabase project (Dashboard > Project Settings > API Keys).
# Use the NEW key names: publishable key (sb_publishable_...) and secret key (sb_secret_...).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Never expose, never prefix with NEXT_PUBLIC. Read only in src/lib/supabase/admin.ts.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Public base URL of this app (used for share links and redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Random string used to hash respondent IPs for rate limiting (Phase 3+).
IP_HASH_SALT=change-me-to-a-long-random-string

# Enables /admin/demo/scale tools. Keep false in production.
ENABLE_DEMO_TOOLS=false
