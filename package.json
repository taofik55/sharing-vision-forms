{
  "name": "formpulse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "seed": "node --env-file=.env.local --conditions=react-server --import tsx scripts/seed.ts",
    "db:start": "supabase start -x imgproxy,vector,logflare,edge-runtime,storage-api",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > src/types/database.ts && prettier --write src/types/database.ts",
    "seed:demo": "node --env-file=.env.local --conditions=react-server --import tsx scripts/seed-demo.ts",
    "bench:dashboard": "node --env-file=.env.local --conditions=react-server --import tsx scripts/bench-dashboard.ts",
    "check:secrets": "node --env-file-if-exists=.env.local scripts/check-client-secrets.mjs",
    "db:dummy-sql": "node --import tsx scripts/generate-dummy-sql.ts",
    "seed:bri": "node --env-file=.env.local --conditions=react-server --import tsx scripts/seed-bri.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-virtual": "3.14.17",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "exceljs": "4.4.0",
    "html-to-image": "1.11.13",
    "lucide-react": "^1.55.0",
    "nanoid": "6.0.2",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "qrcode": "1.5.4",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-grid-layout": "2.3.0",
    "react-hook-form": "^7.90.0",
    "recharts": "3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.21.4",
    "supabase": "^2.120.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  }
}
